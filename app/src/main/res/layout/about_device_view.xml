        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbars="vertical" />

    <ohi.andre.consolelauncher.tuils.OutlineTextView android:id="@+id/tv8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"

        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbars="vertical" />

    <ohi.andre.consolelauncher.tuils.OutlineTextView android:id="@+id/tv9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"

        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbars="vertical" />

    <HorizontalScrollView
        android:id="@+id/header_quick_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:id="@+id/header_quick_apps_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

</LinearLayout>

    <ohi.andre.consolelauncher.managers.status.StorageGaugeView
        android:id="@+id/storage_usage_gauge"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="32dp"
        android:importantForAccessibility="yes"
        android:visibility="visible" />

</FrameLayout>

